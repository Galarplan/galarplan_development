<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================== -->
    <!-- TEMPLATE PRINCIPAL (DUPLICADO) -->
    <!-- =============================== -->
    <template id="report_receipt_validation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id" />
                <div class="page"
                    style="width:21cm; height:29.7cm; margin:0; box-sizing:border-box;">

                    <!-- PRIMER COMPROBANTE -->
                    <div
                        style="
                    page-break-inside:avoid;
                    border-bottom:1px dashed black;
                    padding:0 0.7cm;
                    padding-bottom:0.5cm;
                    margin-bottom:1cm;
                    box-sizing:border-box;
                ">
                        <t t-call="saving_plan_receipt.report_receipt_validation_document" />
                    </div>

                    <!-- SEGUNDO COMPROBANTE -->
                    <div
                        style="
                    position:relative;
                    page-break-inside:avoid;
                    padding:0 0.7cm;
                    box-sizing:border-box;
                ">
                        <t t-call="saving_plan_receipt.report_receipt_validation_document" />
                    </div>

                </div>
            </t>
        </t>
    </template>


