<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_excel_button" model="ir.ui.view">
        <field name="name">account.move.form.excel.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_invoice_excel"
                        type="object"
                        string="Exportar Excel"
                        class="btn-primary"/>
                <button name="action_export_invoice_xml"
                        type="object"
                        string="Exportar XML SRI"
                        class="oe_highlight"/>                        
            </xpath>
        </field>
    </record>
</odoo>