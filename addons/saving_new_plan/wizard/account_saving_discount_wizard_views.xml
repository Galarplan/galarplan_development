<odoo>

    <record id="view_account_saving_discount_wizard" model="ir.ui.view">

        <field name="name">account.saving.discount.wizard.form</field>
        <field name="model">account.saving.discount.wizard</field>

        <field name="arch" type="xml">
            <form string="Confirmación de descuento">

                <group>
                    <field name="saving_id" invisible="1"/>

                    <field name="percent_discount"/>
                </group>

                <footer>

                    <button
                        string="Confirmar"
                        type="object"
                        name="action_confirm_discount"
                        class="btn-primary"/>

                    <button
                        string="Cancelar"
                        special="cancel"/>
                        
                </footer>

            </form>
        </field>

    </record>

</odoo>