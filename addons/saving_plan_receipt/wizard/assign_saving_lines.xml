<odoo>

    <!-- VISTA FORM DEL WIZARD -->
    <record id="view_assign_saving_lines_wz_form" model="ir.ui.view">
        <field name="name">assign.saving.lines.wz.form</field>
        <field name="model">assign.saving.lines.wz</field>
        <field name="arch" type="xml">
            <form string="Aplicar Pago a Cuotas">
                <group>
                    <field name="receipt_id" readonly="1"/>
                    <field name="user_id" readonly="1"/>
                    <field name="saving_id"/>
                    <field name="saving_lines_ids" widget="many2many_tags"/>
                </group>

                <footer>
                    <button name="assign_payment"
                            string="Aplicar Pago"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

        <!-- ACTION DEL WIZARD -->
    <record id="action_assign_saving_lines_wz" model="ir.actions.act_window">
        <field name="name">Aplicar Pago</field>
        <field name="res_model">assign.saving.lines.wz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>