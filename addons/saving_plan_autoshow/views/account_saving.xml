<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de la vista form de account.saving -->


    <record id="view_account_saving_form_inherit_mod_page" model="ir.ui.view">
        <field name="name">account.saving.form.inherit.autoshow</field>
        <field name="model">account.saving</field>
        <field name="inherit_id" ref="fithy_plus_one.view_account_saving_form_inherit" />
        <field name="arch" type="xml">
            <!-- Si la página ya existe en la vista padre, usa este XPath para modificarla -->
            <xpath expr="//page[@name='automatic_payments_page']" position="attributes">
                <attribute name="attrs">{'invisible': [('saving_type', 'in', ['premiun', 'flex'])]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_saving_form_view_inherit_autoshow" model="ir.ui.view">
        <field name="name">account.saving.form.inherit.autoshow</field>
        <field name="model">account.saving</field>
        <field name="inherit_id" ref="saving_new_plan.account_saving_form_view_inherit_discount" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='saving_type']" position="attributes">
                <attribute name="attrs">{'invisible': [('saving_type', 'in', ['premiun', 'flex'])]}</attribute>
            </xpath>


            <xpath expr="//field[@name='enable_discount']" position="attributes">
                <attribute name="attrs">{'invisible': [('saving_type', 'in', ['premiun', 'flex'])]}</attribute>
            </xpath>


            <field name="enable_discount" position="after">
                <field name="number_quotas"
                    string="# Cuotas"
                    attrs="{'invisible': [('saving_type', 'in', ('normal','ballon','flex'))], 'readonly': [('state_plan', '!=', 'draft')]}" />

                <field name="quote_per_number"
                    string="Valor por Cuotas"
                    attrs="{'invisible': [('saving_type', 'in', ('normal','ballon','flex'))], 'readonly': [('state_plan', '!=', 'draft')]}" />

                <field name="special_quote_number"
                    attrs="{'invisible': [('saving_type', 'in', ('normal','ballon','premiun'))], 'readonly': [('state_plan', '!=', 'draft')]}" />
                <!-- Campo 1: premiun_quote -->
                <div class="o_row">
                    <label for="premiun_quote" string="Cuota Premiun" class="oe_inline"
                        attrs="{'invisible': [('saving_type', '!=', 'premiun')]}" />
                    <label for="premiun_quote" string="Cuota Especial" class="oe_inline"
                        attrs="{'invisible': [('saving_type', '!=', 'flex')]}" />

                    <field name="premiun_quote" nolabel="1" class="oe_inline"
                        attrs="{'invisible': [('saving_type', 'in', ('normal','ballon'))], 'readonly': [('state_plan', '!=', 'draft')]}" />
                </div>
                <br />

                <!-- Campo 2: premiun_quote_pending -->
                <div class="o_row">
                    <label for="premiun_quote_pending" string="Cuota Premiun Pendiente"
                        class="oe_inline" attrs="{'invisible': [('saving_type', '!=', 'premiun')]}" />
                    <label for="premiun_quote_pending" string="Cuota Especial Pendiente"
                        class="oe_inline" attrs="{'invisible': [('saving_type', '!=', 'flex')]}" />

                    <field name="premiun_quote_pending" nolabel="1" class="oe_inline"
                        attrs="{'invisible': [('saving_type', 'in', ('normal','ballon'))], 'readonly': [('state_plan', '!=', 'draft')]}" />
                </div>
                <br />

                <!-- Campo 3: premiun_quote_paid -->
                <div class="o_row">
                    <label for="premiun_quote_paid" string="Cuota Premiun Pagada" class="oe_inline"
                        attrs="{'invisible': [('saving_type', '!=', 'premiun')]}" />
                    <label for="premiun_quote_paid" string="Cuota Especial Pagada" class="oe_inline"
                        attrs="{'invisible': [('saving_type', '!=', 'flex')]}" />

                    <field name="premiun_quote_paid" nolabel="1" class="oe_inline"
                        attrs="{'invisible': [('saving_type', 'in', ('normal','ballon'))], 'readonly': [('state_plan', '!=', 'draft')]}" />
                </div>

            </field>


            <field name="line_ids" position="before">
                <separator string="Cuotas Premium"
                    attrs="{'invisible': [('saving_type', 'in',  ('normal','ballon','flex'))]}" />
                <field name="quotes_ids"
                    attrs="{'invisible': [('saving_type', 'in',  ('normal','ballon','flex'))]}">
                    <tree edit='0' create="0" delete="0">
                        <field name="number" />
                        <field name="value" />
                        <field name="paid_value" />
                        <field name="pending_value" />
                    </tree>
                </field>
            </field>


        </field>
    </record>


    <record id="view_account_saving_lines_main_tree_view_inherit" model="ir.ui.view">
        <field name="name">account.saving.lines.main.tree.view.inherit</field>
        <field name="model">account.saving.lines</field>  
        <field name="inherit_id" ref="planes_ahorro.account_saving_lines_main_tree_view" />
        <field name="arch" type="xml">

            <!-- <field name="saving_id" position="after">
                <field name="saving_type" invisible="1" />
            </field> -->

            <field name="seguro_amount" position="after">
                <field name="gl_mensual" attrs="{'column_invisible': [('parent.saving_type', 'in', ['normal', 'ballon','flex'])]}" />
                <field name="disp_mensual" attrs="{'column_invisible': [('parent.saving_type', 'in', ['normal', 'ballon', 'flex'])]}"/>
            </field>
            
            <xpath expr="//field[@name='seguro_amount']" position="attributes">
                <attribute name="attrs">{'column_invisible': [('parent.saving_type', 'in', ['premiun', 'flex'])]}</attribute>
            </xpath>

        </field>
    </record>


    <record id="account_saving_normal_plan" model="ir.actions.act_window">
        <field name="name">Planes de Ahorro</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.saving</field>
        <field name="view_mode">tree,form</field>
        <field name="context">
            {'search_default_filter_draft':1,'search_default_filter_open':1,'search_default_filter_close':1,'default_saving_type':'normal'}</field>
        <field name="domain">[('saving_type','=','normal')]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new record.
            </p>
        </field>
    </record>


