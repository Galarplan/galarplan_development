<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_password_receipt" model="ir.ui.view">
        <field name="name">res.users.form.inherit.password.receipt</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            
            <!-- XPATH: Agregar nueva pestaña después de Preferences -->
            <xpath expr="//notebook/page[@name='preferences']" position="after">
                <page name="password_security" string="Password Security">
                    
                    <group name="password_info_group" string="Password Information">
                        <group>
                            <field name="password_receipt" 
                                   widget="password"
                                   string="Encrypted Password"/>
                        </group>
                        <group>
                            <field name="write_date" 
                                   string="Last Modified"/>
                            <field name="create_date" 
                                   string="Created on"/>
                        </group>
                    </group>
                    
                </page>
            </xpath>
            
        </field>
    </record>
    
   
</odoo>