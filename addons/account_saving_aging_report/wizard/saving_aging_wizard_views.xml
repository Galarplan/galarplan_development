<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del Wizard para Estructura de Cartera -->
        <record id="view_saving_portfolio_wizard_form" model="ir.ui.view">
            <field name="name">saving.portfolio.wizard.form</field>
            <field name="model">saving.portfolio.wizard</field>
            <field name="arch" type="xml">
                <form string="Estructura de Cartera">
                    <sheet>
                        <div class="oe_title">
                            <h1>Estructura de Cartera - Cuentas por Cobrar</h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="output_format" invisible="1"/>
                            </group>
                            <group>
                                <!-- Selección múltiple con tags -->
                                <field name="state_plan_ids" widget="many2many_checkboxes"/>
                                <!-- <field name="show_zero_balance"/> -->
                            </group>
                        </group>
                        <group string="Filtros Adicionales">
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="saving_plan_ids" widget="many2many_tags"/>
                        </group>
                        <footer>
                            <button name="action_generate_report" string="Generar Reporte" type="object" class="btn-primary"/>
                            <button string="Cancelar" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción del Wizard -->
        <record id="action_saving_portfolio_wizard" model="ir.actions.act_window">
            <field name="name">Estructura de Cartera</field>
            <field name="res_model">saving.portfolio.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>