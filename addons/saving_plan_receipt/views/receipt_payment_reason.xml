<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="view_receipt_payment_reason_tree" model="ir.ui.view">
        <field name="name">receipt.payment.reason.tree</field>
        <field name="model">receipt.payment.reason</field>
        <field name="arch" type="xml">
            <tree string="Motivos de Recibo">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_receipt_payment_reason_form" model="ir.ui.view">
        <field name="name">receipt.payment.reason.form</field>
        <field name="model">receipt.payment.reason</field>
        <field name="arch" type="xml">
            <form string="Motivo de Recibo">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_receipt_payment_reason" model="ir.actions.act_window">
        <field name="name">Motivos de Recibo</field>
        <field name="res_model">receipt.payment.reason</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>