<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_receipt_wizard_view_form" model="ir.ui.view">
        <field name="name">report.receipt.wz.form</field>
        <field name="model">report.receipt.wz</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Fechas">
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group string="Filtros">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="location_ids" widget="many2many_tags"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" 
                            string="Generar Reporte" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="report_receipt_wizard_action" model="ir.actions.act_window">
        <field name="name">Reporte de Pagos</field>
        <field name="res_model">report.receipt.wz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem 
        id="menu_receipt_report" 
        name="Reporte Recibos" 
        parent="menu_receipt_validation" 
        action="report_receipt_wizard_action" 
        sequence="7"
    />
</odoo>