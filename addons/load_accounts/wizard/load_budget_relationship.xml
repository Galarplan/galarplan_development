<odoo>
    <record id="view_load_budget_relationship_form" model="ir.ui.view">
        <field name="name">load.accounts.relation.form</field>
        <field name="model">load.budget.relationship</field>
        <field name="arch" type="xml">
            <form string="Cargar Relacion Contable">
                <sheet>
                    <group>
                        <field name="company_id" />
                        <field name="filename" invisible="1" />
                        <field name="file" filename="filename" string="Archivo Excel" />
                        <field name="update_existing" string="Actualizar registros existentes" />
                    </group>
                    <footer>
                        <button name="action_import" string="Importar" type="object"
                            class="btn-primary" />
                        <button string="Cancelar" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_load_budget_rel_accounts" model="ir.actions.act_window">
        <field name="name">Cargar Relacion Contable</field>
        <field name="res_model">load.budget.relationship</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_load_budget_relationship_form" />
    </record>

    <!-- <menuitem id="menu_load_budget_parent"
        name="Cargar Estructura"
        parent="account.menu_finance"
        action="action_load_budget_parent"
        sequence="100" /> -->

    <!-- <menuitem id="menu_budget_load" name="Cargar Estructura"
        parent="oly_budget.menu_budget_config"  action="action_load_budget_parent" sequence="11" /> -->

    <menuitem id="menu_account_load_budget_accounts" name="Cargar Relacion Contables"
        parent="account.menu_finance_reports" sequence="12"
        action="action_load_budget_rel_accounts" />
</odoo>