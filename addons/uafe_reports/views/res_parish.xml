<odoo>

    <record id="view_res_country_parish_tree" model="ir.ui.view">
        <field name="name">res.country.parish.tree</field>
        <field name="model">res.country.parish</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="substate_id"/>
            </tree>
        </field>
    </record>

    <record id="view_res_country_parish_form" model="ir.ui.view">
        <field name="name">res.country.parish.form</field>
        <field name="model">res.country.parish</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="substate_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción
    <record id="action_res_country_parish" model="ir.actions.act_window">
        <field name="name">Parroquias</field>
        <field name="res_model">res.country.parish</field>
        <field name="view_mode">tree,form</field>
    </record> -->

    <record id="action_res_country_parish" model="ir.actions.act_window">
        <field name="name">Parroquias</field>
        <field name="res_model">res.country.parish</field>
        <field name="view_mode">tree,form</field>

        <!-- 👇 FORZAMOS LAS VISTAS -->
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_res_country_parish_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_res_country_parish_form')})
        ]"/>
    </record>    

    <!-- Menú -->
    <menuitem id="menu_res_country_parish"
            name="Parroquias"
            parent="base.menu_administration"
            action="action_res_country_parish"/>
                
</odoo>
