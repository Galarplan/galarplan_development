<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_line_name"
                  inherit_id="vehicle_stock_info.report_invoice_document_custom">

            <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.product_id.name']"
                   position="replace">

                <span t-field="line.name"
                      t-options="{'widget': 'text', 'style': 'font-weight: bold;'}"/>

            </xpath>

        </template>

    </data>
</odoo>